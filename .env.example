# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...   # anon/public key from Supabase dashboard

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── Edge function secrets (set in Supabase dashboard → Project Settings → Edge Functions → Secrets)
# These are NOT prefixed with VITE_ and are never exposed to the browser.

# Supabase service key (auto-injected by Supabase; listed here for local dev only)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM=Respondfall <hello@yourdomain.com>

# AI gateway (optional — falls back to default Lovable endpoint)
LOVABLE_API_KEY=your_lovable_api_key
AI_GATEWAY_URL=https://ai.gateway.lovable.dev/v1/chat/completions

# App URL (used to restrict CORS in edge functions)
APP_URL=https://app.respondfall.com

# Cron secret — set this in Supabase secrets to prevent arbitrary HTTP triggers
# of sequence-runner and send-daily-digest. Pass as x-cron-secret header.
CRON_SECRET=a-long-random-secret
